# MongoDB connection string
MONGODB_URI=

# Secret used to sign JWT tokens (REQUIRED IN PROD)
JWT_SECRET=

# Gemini API Key for AI features
GEMINI_API_KEY=

# The URL of your frontend application (e.g. https://your-frontend.onrender.com)
FRONTEND_URL=

# The base URL of the application for password reset links
APP_URL=

# For the frontend to know where the API is located (e.g. https://your-backend.onrender.com)
VITE_API_URL=

# SMTP Configuration for sending emails (password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
